  // split-flap counters
  var chars = "0123456789+".split("");
  function buildFlap(container, target){
    container.innerHTML = "";
    var cells = [];
    for(var i=0;i<target.length;i++){
      var el = document.createElement('span');
      el.className = 'flap';
      el.textContent = reduce ? target[i] : "0";
      container.appendChild(el);
      cells.push(el);
    }
    if(reduce) return;
    cells.forEach(function(cell, idx){
      var ticks = 10 + idx*4;
      var count = 0;
      var iv = setInterval(function(){
        count++;
        if(count >= ticks){
          cell.textContent = target[idx];
          clearInterval(iv);
        } else {
          cell.textContent = chars[Math.floor(Math.random()*chars.length)];
        }
      }, 45);
    });
  }

  var statEls = document.querySelectorAll('.stat .flap-row');
  var started = false;
  function startStats(){
    if(started) return;
    started = true;
    statEls.forEach(function(row){
      buildFlap(row, row.getAttribute('data-target'));
    });
  }
  // trigger shortly after load (hero is first thing seen)
  window.addEventListener('load', function(){ setTimeout(startStats, 250); });
  setTimeout(startStats, 1200); // fallback

  // stamp-on-scroll for project/arrival stops
  if('IntersectionObserver' in window){
    var stops = document.querySelectorAll('.stop');
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          entry.target.classList.add('is-stamped');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });
    stops.forEach(function(s){ io.observe(s); });
  } else {
    document.querySelectorAll('.stop').forEach(function(s){ s.classList.add('is-stamped'); });
  }
})();
</script>

